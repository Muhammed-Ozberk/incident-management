{
  "info": {
    "_postman_id": "1b4330f2-3f8f-45de-9f62-80a7f5a7b78c",
    "name": "Incident Management API",
    "description": "REST API collection for the real-time incident management case study. Run Services / List Services first to populate serviceId. Realtime Socket.IO events emitted by the backend: incident.created, incident.updated, incident.deleted.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "incidentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "serviceId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Services",
      "item": [
        {
          "name": "List Services",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/services",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Services listed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.message).to.be.a('string');",
                  "  pm.expect(json.status).to.eql(true);",
                  "  pm.expect(json).to.have.property('data');",
                  "  pm.expect(json.data).to.be.an('array');",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.length > 0) {",
                  "  pm.collectionVariables.set('serviceId', json.data[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Service",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Reporting Service\",\n  \"description\": \"Generates customer-facing operational reports.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/services",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Service created or conflict returned', function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.message).to.be.a('string');",
                  "  pm.expect(json.status).to.be.a('boolean');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
